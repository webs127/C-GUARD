# Runtime
NODE_ENV=development
PORT=3000

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/c_guard

# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3001

# Logging
LOG_LEVEL=info

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Authentication (JWT) - use strong random values of at least 32 characters
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Authentication rate limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Optional bootstrap system administrator created by `npm run seed`
# Set both email and password to enable. Existing users are never re-passworded.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_FIRST_NAME=System
# SEED_ADMIN_LAST_NAME=Administrator
# SEED_ADMIN_PHONE=
# SEED_ADMIN_JOB_TITLE=System Administrator
